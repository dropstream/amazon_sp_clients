<%- if summary -%>
      # <%= summary %>
<%- end -%>
<%- if notes -%>
      # <%= notes %>
<%- end -%>
<%- signature_params.each do |p| -%>
      # @param <%= p.name %> <%= p.escaped_description %>
<%- end -%>
      # @param [Hash] opts the optional parameters
<%- optional_params.each do |p| -%>
      # @option opts [<%= p.doc_type %>] :<%= p.name %> <%= p.escaped_description %><%= default_suffix(p) %>
<%- end -%>
      # @return [<%= return_doc %>]
      def <%= method_name %>(<%= sig_args %>opts = {})
<%- if return_type? -%>
        data = <%= method_name %>_with_http_info(<%= sig_args %>opts)
        return data
<%- else -%>
        <%= method_name %>_with_http_info(<%= sig_args %>opts)
        return nil
<%- end -%>
      end

<%- if summary -%>
      # <%= escaped_summary %>
<%- end -%>
<%- if notes -%>
      # <%= escaped_notes %>
<%- end -%>
<%- signature_params.each do |p| -%>
      # @param <%= p.name %> <%= p.escaped_description %>
<%- end -%>
      # @param [Hash] opts the optional parameters
<%- optional_params.each do |p| -%>
      # @option opts [<%= p.doc_type %>] :<%= p.name %> <%= p.escaped_description %>
<%- end -%>
      # @return [Array<(<%= return_doc %>)>] <%= return_doc %><%= ' data' if return_type? %>, response status code and response headers
      def <%= method_name %>_with_http_info(<%= sig_args %>opts = {})
        if @api_client.config.debugging
          @api_client.config.logger.debug 'Calling API: <%= class_name %>.<%= method_name %> ...'
        end
<%= guard_lines -%>
        # resource path
        local_var_path = <%= path_expr %>

        # query parameters
        query_params = opts[:query_params] || {}
<%= query_assign_lines -%>

        # header parameters
        header_params = opts[:header_params] || {}
<%= header_assign_lines -%>

        # form parameters
        form_params = opts[:form_params] || {}

        # http body (model)
        post_body = opts[:body] <%= body_suffix %>

        return_type = opts[:return_type] <%= return_type_suffix %>

        auth_names = opts[:auth_names] || []
        data = @api_client.call_api(:<%= http_method %>, local_var_path,
          :header_params => header_params,
          :query_params => query_params,
          :form_params => form_params,
          :body => post_body,
          :auth_names => auth_names,
          :return_type => return_type)

        if @api_client.config.debugging
          @api_client.config.logger.debug "API called: <%= class_name %>#<%= method_name %>\nData: #{data.inspect}"
        end
        return data
      end
